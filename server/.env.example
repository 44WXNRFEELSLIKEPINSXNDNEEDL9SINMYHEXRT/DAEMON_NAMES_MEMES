# server/ gateway config. Every value is optional (defaults shown). Copy to
# .env; docker-compose.yml loads it if present.

# --- Publishing (docker-compose) ---
# COMPOSE_PROJECT_NAME=daemon-names-memes
# GATEWAY_BIND=127.0.0.1       # 0.0.0.0 to publish without a host proxy
# GATEWAY_PORT=8090
# NGINX_SERVER_NAME=_
# NGINX_TRUSTED_PROXY=127.0.0.1/32   # CIDR of your host reverse proxy, e.g. 172.16.0.0/12
# NGINX_RATE_LIMIT=30r/m
# NGINX_RATE_BURST=10
# REDIS_MAXMEMORY=256mb

# --- Providers ---
# DEFAULT_PROVIDER=worker
# daemon2: base URL of a service/ deployment. With the compose profile:
#   SERVICE_URL=http://service:8080
SERVICE_URL=
# WORKER_URL=https://daemon-meme.windown52358.workers.dev
# UPSTREAM_CONNECT_TIMEOUT_S=10
# UPSTREAM_READ_TIMEOUT_S=150
# UPSTREAM_MAX_CONNECTIONS=100
# GOOGLE_MODEL=gemini-3.1-flash-lite
# CLAUDE_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# MISTRAL_MODEL=mistral-small-latest
# XAI_MODEL=grok-2-vision-1212

# --- Redis ---
# REDIS_URL=redis://redis:6379/0   # external/shared Redis: use its own DB number
# REDIS_SOCKET_TIMEOUT_S=2.0

# --- Perceptual-hash cache ---
# CACHE_ENABLED=1
# PHASH_HAMMING_THRESHOLD=8
# PHASH_HASH_SIZE=8
# CACHE_KEY_PREFIX=dnm:cache:
# CACHE_TTL_S=0
# CACHE_SCAN_WARN_SIZE=50000

# --- Metrics ---
# METRICS_ENABLED=1
# METRICS_QUEUE_SIZE=10000
# METRICS_BATCH_SIZE=200

# --- HTTP ---
# WEB_CONCURRENCY=2
# CORS_ALLOW_ORIGINS=*
# DOCS_ENABLED=0
# MAX_B64_CHARS=8000000
# MAX_REQUEST_BYTES=12000000

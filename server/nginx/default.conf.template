# Rendered by the official nginx image's envsubst step (/etc/nginx/templates)
# — only ${NGINX_*} variables defined in docker-compose.yml are substituted;
# nginx's own $variables are left alone.
#
# Edge guard: coarse, cheap per-IP limit_req in front of the app. The app
# itself does no rate limiting (see server/README.md); service/ and the
# worker enforce their own per-client business limits.
limit_req_zone $binary_remote_addr zone=dnm_gateway_edge:10m rate=${NGINX_RATE_LIMIT};

# Only trust X-Forwarded-For from a reverse proxy you run in front of this
# container (host nginx/Caddy/Traefik). Default trusts nothing extra.
set_real_ip_from ${NGINX_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;
    client_max_body_size 12m;   # matches MAX_REQUEST_BYTES in config.py

    location = /health {
        access_log off;
        proxy_pass http://app:8090;
        proxy_set_header Host $host;
    }

    location ~ ^/(classify|correct)$ {
        limit_req zone=dnm_gateway_edge burst=${NGINX_RATE_BURST} nodelay;
        limit_req_status 429;

        proxy_pass http://app:8090;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # OVERWRITE, never append: the app trusts this header from nginx, so a
        # client-supplied X-Forwarded-For must not survive to the app.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # daemon2 (CPU VLM) requests can take 20-30s+, more when queued.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Nothing else is served — keeps this container from shadowing other
    # applications when it sits behind a shared host proxy.
    location / {
        return 404;
    }
}
